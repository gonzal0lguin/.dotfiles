# ~/.config/zsh/secrets.zsh — tokens and keys (NOT tracked by git, chmod 600).
# Copy this file to secrets.zsh and fill it in.
#
# Prefer asking a tool for the token over pasting it here:
(( $+commands[gh] )) && export GITHUB_TOKEN=$(gh auth token 2>/dev/null)
#
# Otherwise:
# export OPENAI_API_KEY="..."
# export HF_TOKEN="..."
