# ~/.config/zsh/local.zsh — machine-specific config (NOT tracked by git).
# Copy this file to local.zsh and edit. Loaded last, so it can override anything.

# --- ROS 2 -----------------------------------------------------------------
# [[ -r /opt/ros/jazzy/setup.zsh ]] && source /opt/ros/jazzy/setup.zsh
# export ROS_DOMAIN_ID=9

# --- project shortcuts --------------------------------------------------------
