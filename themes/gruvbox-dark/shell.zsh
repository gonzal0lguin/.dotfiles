# Gruvbox Dark for shell tools (sourced by ~/.config/zsh/env.zsh)
export DOTFILES_THEME=gruvbox-dark
export BAT_THEME="gruvbox-dark"          # also used by git-delta
export FZF_THEME_OPTS="--color=bg+:#3c3836,bg:#282828,spinner:#fb4934,hl:#928374 \
--color=fg:#ebdbb2,header:#928374,info:#8ec07c,pointer:#fb4934 \
--color=marker:#fb4934,fg+:#ebdbb2,prompt:#fb4934,hl+:#fb4934 \
--color=border:#665c54,label:#ebdbb2"
